{
  "manifest_version": 3,
  "name": "Remote Haunt",
  "version": "1.1.0",
  "description": "Executes background actions in browser tabs on command from the Poltergeist bridge",
  "browser_specific_settings": {
    "gecko": {
      "id": "remote-haunt@local"
    }
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://meet.google.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Remote Haunt Status",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  }
}